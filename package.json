{
  "name": "autodekt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --filter=@autodekt/client --filter=@autodekt/backend",
    "dev:client": "turbo dev --filter=@autodekt/client",
    "dev:desktop": "turbo dev --filter=@autodekt/desktop",
    "dev:backend": "turbo dev --filter=@autodekt/backend",
    "build": "turbo build",
    "build:client": "turbo build --filter=@autodekt/client",
    "build:desktop": "turbo build --filter=@autodekt/desktop",
    "start:desktop": "pnpm build:client && pnpm build:desktop && pnpm --filter @autodekt/desktop start",
    "package:desktop": "pnpm build:client && pnpm --filter @autodekt/desktop package",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:watch": "pnpm --filter @autodekt/client test:watch",
    "check": "oxlint apps packages && oxfmt --check apps packages *.json *.md *.yaml"
  },
  "devDependencies": {
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "turbo": "latest",
    "typescript": "latest"
  },
  "packageManager": "pnpm@11.5.3"
}
