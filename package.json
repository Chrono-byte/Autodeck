{
  "name": "autodekt",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:desktop": "pnpm --filter @autodekt/desktop dev",
    "dev:backend": "convex dev",
    "build": "vite build && tsc --noEmit",
    "build:desktop": "pnpm --filter @autodekt/desktop build",
    "start:desktop": "pnpm build && pnpm build:desktop && pnpm --filter @autodekt/desktop start",
    "package:desktop": "pnpm build && pnpm --filter @autodekt/desktop package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@convex-dev/better-auth": "latest",
    "@earendil-works/pi-ai": "latest",
    "@tanstack/ai": "latest",
    "@tanstack/ai-client": "latest",
    "@tanstack/ai-openai": "latest",
    "@tanstack/ai-react": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "~1.6.15",
    "convex": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
